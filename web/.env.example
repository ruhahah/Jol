# Скопируй в .env.local. Пока переменные пустые, сайт показывает демо-данные.

# Имя бота без @ — включает кнопки «Добавить место в Telegram»
VITE_BOT_USERNAME=

# Supabase → Project Settings → API. Нужен только публичный anon-ключ (не service_role!)
# и выполненный db/public_api.sql.
VITE_SUPABASE_URL=
VITE_SUPABASE_ANON_KEY=
