# Скопируй в .env и заполни. Файл .env никогда не коммить.

# --- MVP-0 (нужно сейчас) ---
# Токен от @BotFather
BOT_TOKEN=
# Supabase → Connect → Session pooler (хост *.pooler.supabase.com, порт 5432).
# "Direct connection" у Supabase только по IPv6 и с домашнего интернета часто не работает.
DATABASE_URL=postgresql://postgres.PROJECT_REF:PASSWORD@aws-0-REGION.pooler.supabase.com:5432/postgres

# Только для хостинга: внешний адрес сервиса, на который Telegram шлёт сообщения.
# На своём компьютере не заполнять (бот сам опрашивает Telegram).
# На Render тоже не нужно: адрес берётся из RENDER_EXTERNAL_URL автоматически.
# WEBHOOK_URL=https://example.onrender.com

# --- Позже (неделя 3+), пока не заполнять ---
# SUPABASE_URL=
# SUPABASE_ANON_KEY=
# SUPABASE_SERVICE_ROLE_KEY=
# STORAGE_BUCKET=entrance-photos
# VISION_API_KEY=
# ORS_API_KEY=
