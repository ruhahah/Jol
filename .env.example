# Скопируй в .env и заполни. Файл .env никогда не коммить.

# --- Бот ---
# Токен от @BotFather
BOT_TOKEN=
# Supabase → Project Settings → API: адрес проекта вида https://abcdefgh.supabase.co
SUPABASE_URL=
# Supabase → Project Settings → API Keys: секретный ключ (sb_secret_... или service_role).
# Даёт полный доступ к базе: никому не показывать и не вставлять в код сайта.
SUPABASE_SECRET_KEY=

# Только для хостинга: внешний адрес сервиса, на который Telegram шлёт сообщения.
# На своём компьютере не заполнять (бот сам опрашивает Telegram).
# На Render тоже не нужно: адрес берётся из RENDER_EXTERNAL_URL автоматически.
# WEBHOOK_URL=https://example.onrender.com

# --- Только для изменения схемы базы (боту не нужно) ---
# Supabase → Connect → Session pooler. Спецсимволы в пароле нужно кодировать (@ → %40).
# Порт 5432 закрыт во многих сетях — тогда SQL-файлы проще запускать в SQL Editor на сайте.
# DATABASE_URL=postgresql://postgres.PROJECT_REF:PASSWORD@aws-0-REGION.pooler.supabase.com:5432/postgres

